# Telora needs no secrets.
# The OCR engine (Tesseract.js) runs in the visitor's browser and needs no API key.
# NEXT_PUBLIC_BRAND_FILES is set automatically by next.config.ts at build time; do not set it here.
# NEXT_PUBLIC_BRAND_FILES=

# What the example (seed) posters show. Read only by getAdapter() in lib/adapter/index.ts.
# "fake": seed posters with SAMPLE OCR numbers, labelled "Sample OCR" in the report.
# "real": seed posters with no OCR numbers (nothing is invented).
# Uploads get the live in-browser 8-distance OCR check in both modes.
# Anything other than "real" falls back to "fake".
ADAPTER_MODE=fake
